# syntax=docker/dockerfile:1
FROM public.ecr.aws/awsguru/aws-lambda-adapter:1.1.0 AS adapter
FROM fortress-search:dev
COPY --from=adapter /lambda-adapter /opt/extensions/lambda-adapter
ENV HOME=/tmp PORT=8081 FORTRESS_NO_SANDBOX=1 AWS_LWA_PORT=8081 AWS_LWA_READINESS_CHECK_PATH=/healthz AWS_LWA_READINESS_CHECK_HEALTHY_STATUS=200
